# Brevo (Sendinblue) transactional email API key
# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Pavel workshop checkout — enable via EITHER approach:
#
# (A) Hosted Stripe Payment Links, one per region. No secret key required.
#     Set each link's post-payment redirect to /pavel/thank-you in the dashboard.
STRIPE_PAYMENT_LINK_REST=
STRIPE_PAYMENT_LINK_IN=
#
# (B) Stripe secret key (sk_test_... / sk_live_...). Takes priority if set and
#     carries the buyer's name/email/ticket through to the thank-you page.
#     https://dashboard.stripe.com/test/apikeys
# Leave all of the above empty to keep the no-payment fallback (the button still
# reaches the thank-you page without charging).
STRIPE_SECRET_KEY=

# Absolute site origin used to build Stripe success/cancel redirect URLs.
# Optional locally (falls back to the request origin); set in production, e.g.
# https://fynix.digital
NEXT_PUBLIC_SITE_URL=

# Secret that signs the anti-bot honeypot form tokens on the Pavel checkout.
# Set to a long random string in every deployed environment (e.g. `openssl rand -hex 32`).
# Falls back to an insecure dev default if unset — DO NOT ship without setting it.
PAVEL_FORM_SECRET=

# Sentry — build-time token used by next.config.ts to upload source maps.
# Required in CI/Vercel only; without it production stack traces stay minified.
# Create at https://fynix-digital.sentry.io/settings/auth-tokens/ (scope: project:releases)
SENTRY_AUTH_TOKEN=

# Sentry DSNs are optional overrides. The project DSN is hardcoded as a
# fallback in the sentry.*.config.ts files, so these only need setting to point
# a deployment at a different Sentry project.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Google Tag Manager Container ID (e.g. GTM-T5W9T5VF)
NEXT_PUBLIC_GTM_ID=GTM-T5W9T5VF

