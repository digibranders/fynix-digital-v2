# Brevo (Sendinblue) transactional email API key
# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Postgres — stores Pavel workshop registrations + the email idempotency log.
# Server-only; never prefix NEXT_PUBLIC. Uses the standard postgres-js driver,
# so the SAME connection style works for local dev and the production DO droplet.
#   Local (pgAdmin / Homebrew): postgresql://<user>@localhost:5432/<db>
#   Production (DO droplet):     postgresql://<user>:<pass>@<host>:5432/<db>
# Create the tables from the schema:
#   npm run db:push                       (interactive; needs a TTY)
#   or: psql -d <db> -f drizzle/0000_*.sql (non-interactive)
DATABASE_URL=

# Razorpay webhook secret. Create a webhook in the Razorpay dashboard pointed at
# <site>/api/pavel/webhook for the `payment.captured` and `order.paid` events,
# set a secret there, and paste the SAME value here. Locally, expose the route
# with a tunnel (e.g. `ngrok http 3000`) and register that URL as the webhook.
RAZORPAY_WEBHOOK_SECRET=

# Shared secret guarding the reminders cron route (/api/pavel/cron/reminders)
# so it can't be triggered publicly. Any long random string.
# The route accepts EITHER CRON_SECRET or PAVEL_CRON_SECRET. In production, name
# it CRON_SECRET so Vercel Cron auto-sends `Authorization: Bearer <CRON_SECRET>`.
# Locally, trigger manually, e.g.:
#   curl -H "Authorization: Bearer <secret>" \
#     "http://localhost:3000/api/pavel/cron/reminders?type=reminder_week"
PAVEL_CRON_SECRET=

# Pavel workshop checkout — Razorpay API keys.
#   Test keys: https://dashboard.razorpay.com/app/website-app-settings/api-keys
#   Use rzp_test_... while testing and swap to rzp_live_... on launch.
# The key id is publishable (sent to the browser Checkout overlay); the secret
# is server-only — never prefix it with NEXT_PUBLIC. Leave both empty to keep
# the no-payment fallback (the button still reaches the thank-you page without
# charging). USD (the REST region) requires international payments to be enabled
# on the Razorpay account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Absolute site origin. Optional locally (falls back to the request origin); set
# in production, e.g. https://fynix.digital
NEXT_PUBLIC_SITE_URL=

# Origin the browser calls for the Pavel API. The marketing site (Vercel) and the
# API + database (DigitalOcean droplet) live on different origins in production,
# so client fetches go cross-origin. Inlined at BUILD time.
#   Vercel build:            https://api.fynix.digital
#   Local / droplet build:   leave empty (same-origin — the app serves its own API)
NEXT_PUBLIC_API_BASE_URL=

# Comma-separated list of browser origins the droplet API grants CORS to (see
# middleware.ts). Server-only; set on the droplet, not on Vercel. Empty locally.
#   Production: https://fynix.digital
ALLOWED_ORIGIN=

# Secret that signs the anti-bot honeypot form tokens on the Pavel checkout.
# Set to a long random string in every deployed environment (e.g. `openssl rand -hex 32`).
# If unset, a random per-process secret is used: single-process hosts (droplet,
# local dev) keep working, but tokens will not verify across serverless
# instances or restarts — so production MUST set it.
# Each host signs with its own copy, and a token must be issued and verified by
# the SAME host, so the two deployments do not need matching values.
FORM_SECRET=

# Credentials for the admin console at /admin. REQUIRED — there are no defaults,
# and with either value unset the console refuses every login (fails closed).
#
# Set these on whichever host SERVES /admin (Vercel), not on the one that only
# backs it: the password is checked where the page renders.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Secret that signs the admin session cookie. Use a long random string
# (e.g. `openssl rand -hex 32`). If unset, a random per-process secret is used:
# sessions cannot be forged, but they will not survive restarts or span
# serverless instances — so production MUST set it.
ADMIN_SESSION_SECRET=

# The PAVEL_-prefixed spellings of the four names above (PAVEL_FORM_SECRET,
# PAVEL_ADMIN_EMAIL, PAVEL_ADMIN_PASSWORD, PAVEL_ADMIN_SESSION_SECRET) are still
# read as a fallback, so an environment can migrate on its own schedule. They
# name one workshop for what is now console-wide config; prefer the names above.

# --- Admin console <-> data service link -------------------------------------
# The console is served from ONE place (fynix.digital, on Vercel), but Postgres
# lives on the droplet and is bound to localhost. So the console calls the
# droplet's internal admin API (/api/admin/data/*) server-to-server. Set the
# SAME secret on both deployments; without it the endpoints return 404 and the
# dashboard cannot load. Generate with `openssl rand -hex 32`.
ADMIN_PROXY_SECRET=

# Origin serving that internal API. Defaults to NEXT_PUBLIC_API_BASE_URL, so a
# standard Vercel deployment needs only the secret above. Set explicitly to
# point the console at a different backend.
#   Vercel: https://api.fynix.digital     Droplet / local: leave empty
ADMIN_API_ORIGIN=

# Set to "true" on hosts that back the console but must not serve it — i.e. the
# droplet. /admin and the session routes then return 404 there, so
# fynix.digital/admin is the only console. Leave unset on Vercel and locally.
ADMIN_UI_DISABLED=

# Sentry — build-time token used by next.config.ts to upload source maps.
# Required in CI/Vercel only; without it production stack traces stay minified.
# Create at https://fynix-digital.sentry.io/settings/auth-tokens/ (scope: project:releases)
SENTRY_AUTH_TOKEN=

# Sentry DSNs are optional overrides. The project DSN is hardcoded as a
# fallback in the sentry.*.config.ts files, so these only need setting to point
# a deployment at a different Sentry project.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Zoom Server-to-Server OAuth (Marketplace > Develop > Build App).
# Registers paid buyers into the active webinar and reads attendance afterwards.
# Server-only; the client secret must never reach the browser. Leave empty and
# webinar registration is skipped (logged), so the rest of the pipeline still
# works. Required scopes:
#   webinar:write:registrant:admin        webinar:write:batch_registrants:admin
#   webinar:update:registrant_status:admin  webinar:read:list_registrants:admin
#   report:read:list_webinar_participants:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Secret Token from the app's Feature tab. Verifies the signature on event
# notifications Zoom posts to /api/pavel/zoom/webhook.
ZOOM_WEBHOOK_SECRET_TOKEN=

# Minutes a seat must attend before the workshop counts as completed and a
# certificate is issued. Default 90 of the 180-minute session.
PAVEL_ATTENDANCE_MIN_MINUTES=

# Google Tag Manager Container ID (e.g. GTM-T5W9T5VF)
NEXT_PUBLIC_GTM_ID=GTM-T5W9T5VF

